# ============================================================
#  CivicReport environment template
#
#  Copy this file to .env and fill it in:
#      cp .env.example .env
#      npm run start:env
#
#  .env is gitignored. The key is read only by server.js and is
#  never sent to the browser. Do not paste it into app.js,
#  index.html or any file that ships to the client.
# ============================================================

# Required for the AI features. Get one at https://aistudio.google.com/apikey
# Everything except AI analysis and insights works without it.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash. If the model is retired the server
# retries once against the rolling alias gemini-flash-latest.
#GEMINI_MODEL=gemini-2.5-flash

# --- Server -------------------------------------------------
#PORT=3000
#HOST=0.0.0.0
#NODE_ENV=production

# --- Hardening ----------------------------------------------
# Leave at 'self' unless the app must render inside a host page, in which
# case list that host explicitly, for example:
#   ALLOWED_FRAME_ANCESTORS='self' https://preview.example.com
#ALLOWED_FRAME_ANCESTORS='self'

# Only set this when a trusted reverse proxy sits in front of the server.
# It makes X-Forwarded-For the rate-limit identity.
#TRUST_PROXY=0

# Only meaningful when the app is served over HTTPS.
#ENABLE_HSTS=0

# --- Limits -------------------------------------------------
#MAX_JSON_BYTES=4000000
#MAX_IMAGE_BYTES=2500000
#RATE_LIMIT_MAX=12
#RATE_LIMIT_WINDOW_MS=600000
#MAX_CONCURRENT_AI=4
#UPSTREAM_TIMEOUT_MS=30000
